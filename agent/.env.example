# 复制为 .env 后填入自己的 Key（agent/.env 已被 .gitignore 忽略）
# 控制台版（main.py）与网页版（web.py）共用这一份配置
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM（两个版本共用）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_TIMEOUT=120

# 控制台版行为
AGENT_MAX_STEPS=10
AGENT_COMMAND_OUTPUT_MAX_CHARS=4000
AGENT_SHELL=/bin/bash

# 网页版行为（网页版与控制台版是同一个 Agent：同一人设 agent.md + 同一套技能/命令能力）
AGENT_WEB_HOST=0.0.0.0
AGENT_WEB_PORT=8000
AGENT_WEB_MAX_HISTORY=20
AGENT_WEB_MAX_SESSIONS=50
AGENT_WEB_MAX_MESSAGE_CHARS=4000
# 是否允许网页触发命令执行（1=允许，与控制台版一致；0=只聊天、不动本机）
AGENT_WEB_TOOLS=1
# 可选：网页渠道的补充提示词（手机小屏 / 语音朗读）
# AGENT_WEB_EXTRA_INSTRUCTIONS=## 手机端补充要求\n回答控制在 100 字以内
